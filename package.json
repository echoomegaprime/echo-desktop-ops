{
  "name": "@echoomegaprime/echo-desktop-ops",
  "version": "2.0.0",
  "description": "Governed Codex Desktop control deck for truthful ECHO, fleet, OpenClaw, memory, GPU, model-catalog, and build-gate status.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "echo-desktop-ops": "dist/stdio.js",
    "echo-desktop-ops-http": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "package:stage": "node scripts/stage-plugin.mjs",
    "start": "node dist/stdio.js",
    "start:http": "node dist/cli.js",
    "dev": "tsx src/stdio.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/echoomegaprime/echo-desktop-ops.git"
  },
  "keywords": [
    "echo",
    "mcp",
    "oauth",
    "echoomegaprime",
    "echo-desktop-ops"
  ],
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
